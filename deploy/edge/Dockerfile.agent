# relikey-agent image: the static binary from agent/build.py (dist/), nothing else.
# Build from the repository root:  podman build -f deploy/edge/Dockerfile.agent -t relikey-agent:dev .
# The prep stage only makes directories: it runs on the build platform, so other targets need no emulation.
FROM --platform=$BUILDPLATFORM docker.io/library/busybox:1.38.0@sha256:a46257e06c82ad85242d0d38077d0a52d9896389ca60a1a59d3463db586e5fa4 AS prep
# The state directory exists in the image 0700 and owned by the agent's user, so a fresh
# named volume starts with the rights the agent insists on (it refuses anything looser). The metrics directory
# (metrics_dir, optional) is 0755 for the same reason: a collector reads it, the agent writes it.
RUN mkdir -p /out/var/lib/relikey /out/var/lib/relikey-metrics /out/etc/relikey && chmod 0700 /out/var/lib/relikey

FROM scratch
ARG TARGETARCH
ARG TARGETVARIANT
COPY --chmod=0555 agent/dist/relikey-agent-linux-${TARGETARCH}${TARGETVARIANT} /relikey-agent
# The parent is copied, not each directory: `COPY --chmod` on a directory sets its contents' mode, and buildah (podman
# 4.9) leaves the copied directory itself 0755, which podman then copies into a fresh volume (rc.3 walk R4, #165).
# Copied as entries of /out/var/lib, both keep the mode the prep stage gave them, on any builder.
COPY --from=prep --chown=65532:65532 /out/var/lib/ /var/lib/
COPY --from=prep /out/etc/relikey /etc/relikey
USER 65532:65532
ENTRYPOINT ["/relikey-agent"]
CMD ["run", "-config", "/etc/relikey/agent.json"]
