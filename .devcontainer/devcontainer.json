// The ReliKey demo in a Codespace: the real edge agent against stand-ins, nothing else (docs/demo.md).
{
  "name": "ReliKey demo",
  "image": "mcr.microsoft.com/devcontainers/go:1.27@sha256:1dc3589c1ac5d2e7c3077f7138687d47e3a6f5dd0b34f3acd28bb4c075c80f4a",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "cd agent && go build -o /tmp/relikey-demo ./cmd/relikey-demo",
  "postAttachCommand": "/tmp/relikey-demo -addr 127.0.0.1:8080 -no-open -wait",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "ReliKey demo", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/demo.md"] },
    "vscode": { "extensions": ["golang.go"] }
  }
}
